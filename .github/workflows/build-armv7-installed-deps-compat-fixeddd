name: Build LeviLauncher ARMv7.yaml installed-dependency compatibility APK (experimental)

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build-armv7:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Check out this builder workflow
        uses: actions/checkout@v4

      - name: Check out LeviLaunchroid source and native submodules
        uses: actions/checkout@v4
        with:
          repository: LiteLDev/LeviLaunchroid
          ref: main
          path: source
          fetch-depth: 0
          submodules: recursive

      - name: Configure source for ARMv7 and avoid desktop-only LevelDB utility
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path

          # Make the app target 32-bit ARM for this experimental build.
          gradle_file = Path('app/build.gradle')
          s = gradle_file.read_text(encoding='utf-8')
          old = "abiFilters 'arm64-v8a'"
          if s.count(old) != 1:
              raise SystemExit(
                  f'Expected exactly one ABI filter {old!r}; found {s.count(old)}. '
                  'Upstream may have changed; refusing to patch the wrong file.'
              )
          s = s.replace(old, "abiFilters 'armeabi-v7a'")
          s = s.replace('mappingFileUploadEnabled true', 'mappingFileUploadEnabled false')
          s = s.replace('nativeSymbolUploadEnabled true', 'nativeSymbolUploadEnabled false')
          gradle_file.write_text(s, encoding='utf-8')

          # leveldbutil is a standalone desktop CLI; the Android app uses the
          # LevelDB library through leviworld and does not need this executable.
          cmake_file = Path('app/src/main/cpp/worldtools/vendor/leveldb/CMakeLists.txt')
          cm = cmake_file.read_text(encoding='utf-8')
          old_block = "\n".join([
              "add_executable(leveldbutil",
              '  "db/leveldbutil.cc"',
              ")",
              "target_link_libraries(leveldbutil leveldb)",
          ])
          new_block = "\n".join([
              "# leveldbutil is a desktop command-line tool; it is not used in the Android app.",
              "if(NOT ANDROID)",
              "  add_executable(leveldbutil",
              '    "db/leveldbutil.cc"',
              "  )",
              "  target_link_libraries(leveldbutil leveldb)",
              "endif()",
          ])
          if old_block in cm:
              cm = cm.replace(old_block, new_block, 1)
              cmake_file.write_text(cm, encoding='utf-8')
              print('Skipped the desktop-only leveldbutil target for Android.')
          elif 'if(NOT ANDROID)' in cm and 'add_executable(leveldbutil' in cm:
              print('leveldbutil already has an Android guard; leaving it unchanged.')
          else:
              raise SystemExit(
                  f'Expected leveldbutil block not found in {cmake_file}; '
                  'upstream changed. No guessed CMake patch applied.'
              )

          # Fix the NBT string hash for 32-bit size_t. The upstream code uses
          # 64-bit FNV-1a constants unconditionally, which Clang correctly rejects
          # on ARMv7 when -Werror is enabled. Use FNV-1a 32-bit on 32-bit builds
          # and preserve FNV-1a 64-bit on 64-bit builds.
          hash_file = Path('app/src/main/cpp/worldtools/vendor/nbt/src/nbt/detail/StringUtils.hpp')
          hs = hash_file.read_text(encoding='utf-8')
          old_hash = "\n".join([
              "[[nodiscard]] constexpr size_t doHash(std::string_view x) {",
              "    size_t           hash  = 0xcbf29ce484222325;",
              "    constexpr size_t prime = 0x100000001b3;",
              "    for (char c : x) {",
              "        hash ^= static_cast<size_t>(c);",
              "        hash *= prime;",
              "    }",
              "    return hash;",
              "}",
          ])
          new_hash = "\n".join([
              "[[nodiscard]] constexpr size_t doHash(std::string_view x) {",
              "    if constexpr (sizeof(size_t) <= sizeof(uint32_t)) {",
              "        uint32_t hash = 0x811c9dc5u;",
              "        constexpr uint32_t prime = 0x01000193u;",
              "        for (char c : x) {",
              "            hash ^= static_cast<uint32_t>(static_cast<unsigned char>(c));",
              "            hash *= prime;",
              "        }",
              "        return static_cast<size_t>(hash);",
              "    } else {",
              "        uint64_t hash = 0xcbf29ce484222325ULL;",
              "        constexpr uint64_t prime = 0x100000001b3ULL;",
              "        for (char c : x) {",
              "            hash ^= static_cast<uint64_t>(static_cast<unsigned char>(c));",
              "            hash *= prime;",
              "        }",
              "        return static_cast<size_t>(hash);",
              "    }",
              "}",
          ])
          if old_hash in hs:
              hs = hs.replace(old_hash, new_hash, 1)
              if '#include <cstdint>' not in hs:
                  hs = hs.replace('#include <string>', '#include <cstdint>\n#include <string>', 1)
              hash_file.write_text(hs, encoding='utf-8')
              print('Patched NBT doHash for 32-bit and 64-bit size_t.')
          elif 'sizeof(size_t) <= sizeof(uint32_t)' in hs:
              print('NBT doHash already has the ARMv7-safe implementation.')
          else:
              raise SystemExit(
                  f'Expected doHash implementation not found in {hash_file}; '
                  'upstream changed. No guessed hash patch applied.'
              )

          # If Minecraft's APK/cache does not provide libc++_shared.so,
          # fall back to the same-ABI C++ runtime packaged with this launcher APK.
          # Do this only for libc++_shared.so; never overwrite game-specific libraries.
          runtime_file = Path('app/src/main/java/org/levimc/launcher/core/minecraft/GamePackageManager.kt')
          rt = runtime_file.read_text(encoding='utf-8')
          marker = "        verifyLibraries(outputDir)"
          fallback = """        // Some installed Minecraft packages/splits do not expose libc++_shared.so
          // in the extracted runtime cache. The launcher APK already packages the
          // same-ABI C++ shared runtime, so use it as a fallback only when absent.
          val cachedLibcxx = File(outputDir, "libc++_shared.so")
          if (!cachedLibcxx.isFile || cachedLibcxx.length() == 0L) {
              val launcherLibcxx = File(context.applicationInfo.nativeLibraryDir, "libc++_shared.so")
              if (launcherLibcxx.isFile && launcherLibcxx.length() > 0L) {
                  try {
                      launcherLibcxx.inputStream().use { input ->
                          copyStreamToReadOnlyFile(input, cachedLibcxx)
                      }
                      report("Copied libc++_shared.so from launcher native library directory as fallback")
                      if (!processNativeImage(cachedLibcxx, true)) {
                          cachedLibcxx.delete()
                          throw IOException("Failed to prepare fallback native library: libc++_shared.so")
                      }
                  } catch (e: Exception) {
                      Log.w(TAG, "Failed to copy launcher libc++_shared.so fallback: ${e.message}")
                      report("Failed to copy launcher libc++_shared.so fallback: ${e.message}")
                  }
              } else {
                  report("Launcher libc++_shared.so fallback is not available")
              }
          }
          """
          if marker in rt:
              if 'Copied libc++_shared.so from launcher native library directory as fallback' not in rt:
                  rt = rt.replace(marker, fallback + marker, 1)
                  runtime_file.write_text(rt, encoding='utf-8')
                  print('Added libc++_shared.so runtime-cache fallback.')
              else:
                  print('libc++_shared.so runtime-cache fallback already exists.')
          else:
              raise SystemExit(f'Expected insertion point not found in {runtime_file}; refusing to patch.')

          print('Configured the app for armeabi-v7a.')
          PY
          cat > app/google-services.json <<'JSON'
          {
            "project_info": {
              "project_number": "000000000000",
              "project_id": "ci-placeholder",
              "storage_bucket": "ci-placeholder.appspot.com"
            },
            "client": [
              {
                "client_info": {
                  "mobilesdk_app_id": "1:000000000000:android:0000000000000000000000",
                  "android_client_info": {"package_name": "org.levimc.launcher"}
                },
                "oauth_client": [],
                "api_key": [{"current_key": "AIzaSyCIOnlyPlaceholderKey"}],
                "services": {"appinvite_service": {"other_platform_oauth_client": []}}
              }
            ],
            "configuration_version": "1"
          }
          JSON
          chmod +x ./gradlew

      - name: Add experimental ARMv7 gxcore compatibility shim
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          cat > app/src/main/cpp/armv7_gxcore_compat.cpp <<'CPP'
          /* Experimental ARMv7 compatibility shim; not equivalent to proprietary gxcore. */
          #include <jni.h>

          extern "C" JNIEXPORT jboolean JNICALL
          Java_org_levimc_launcher_util_NativeBridgeHelper_nativeScanImage(
              JNIEnv *, jclass, jstring) {
              return JNI_FALSE;
          }

          extern "C" JNIEXPORT jboolean JNICALL
          Java_org_levimc_launcher_util_NativeBridgeHelper_nativeRewriteImage(
              JNIEnv *, jclass, jstring, jstring) {
              return JNI_FALSE;
          }

          extern "C" JNIEXPORT void JNICALL
          Java_org_levimc_launcher_util_NativeBridgeHelper_nativeBootstrapGxCore(
              JNIEnv *, jclass) {
          }

          extern "C" JNIEXPORT jstring JNICALL
          Java_org_levimc_launcher_util_NativeBridgeHelper_nativeLoadMinecraftRuntime(
              JNIEnv *, jclass, jstring) {
              return nullptr;
          }
          CPP

          python3 - <<'PYCODE'
          from pathlib import Path

          cmake_file = Path('app/src/main/cpp/CMakeLists.txt')
          cmake = cmake_file.read_text(encoding='utf-8')
          marker = 'ARMV7_GXCORE_COMPAT_SHIM'
          if marker not in cmake:
              cmake += '''

          # ARMV7_GXCORE_COMPAT_SHIM: experimental fallback for ABI lacking upstream gxcore.
          if(ANDROID AND CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a")
              if(NOT TARGET gxcore)
                  add_library(gxcore SHARED armv7_gxcore_compat.cpp)
                  set_target_properties(gxcore PROPERTIES OUTPUT_NAME "gxcore")
                  target_compile_options(gxcore PRIVATE -fvisibility=hidden -fno-exceptions -fno-rtti)
              endif()
          endif()
          '''
              cmake_file.write_text(cmake, encoding='utf-8')
              print('Added ARMv7 gxcore compatibility target.')
          else:
              print('ARMv7 gxcore compatibility target already exists.')

          # The shim intentionally does not implement the custom runtime loader.
          # Do not use that ARM64-oriented path in the ARMv7 process.
          runtime_file = Path('app/src/main/java/org/levimc/launcher/core/minecraft/MinecraftRuntimePreparer.kt')
          runtime = runtime_file.read_text(encoding='utf-8')
          old = 'if (gameManager.shouldLoadMallocRedirect()) {'
          new = 'if (gameManager.shouldLoadMallocRedirect() && android.os.Process.is64Bit()) {'
          if old in runtime:
              runtime = runtime.replace(old, new, 1)
              runtime_file.write_text(runtime, encoding='utf-8')
              print('Disabled the custom runtime-loader path on ARMv7.')
          elif new in runtime:
              print('ARMv7 custom runtime-loader bypass already exists.')
          else:
              raise SystemExit('Could not find expected runtime-loader condition; refusing to guess.')
          PYCODE

      - name: Fix runtime dependency resolution using the installed official Minecraft package
        working-directory: source
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path

          path = Path('app/src/main/java/org/levimc/launcher/core/minecraft/GamePackageManager.kt')
          s = path.read_text(encoding='utf-8')

          # Do not manually load PairIP into the launcher process; the supplied tombstone
          # shows JNI_OnLoad aborting there with a null class.
          # Preserve the game's PairIP library and integrity checks unchanged.
          array_start = s.find('private val systemLoadedLibs = arrayOf(')
          if array_start < 0:
              raise SystemExit('systemLoadedLibs definition not found; refusing to guess.')
          array_end = s.find('\n    )', array_start)
          if array_end < 0:
              raise SystemExit('systemLoadedLibs array end not found; refusing to guess.')
          array_text = s[array_start:array_end]
          if '"libpairipcore.so"' in array_text:
              raise SystemExit("PairIP must not be loaded from the launcher process.")
          old_order = '        val allLibs = requiredLibs + systemLoadedLibs'
          new_order = """        // Load libraries in dependency order; libc++ must be available first.
                  val allLibs = buildList {
                      add("libc++_shared.so")
                      requiredLibs.filterNot { it == "libc++_shared.so" }.forEach { add(it) }
                      systemLoadedLibs.forEach { add(it) }
                  }.distinct()"""
          if old_order in s:
              s = s.replace(old_order, new_order, 1)
          elif new_order in s:
              print('Library loading order already patched.')
          else:
              raise SystemExit('Expected loadAllLibraries order not found; refusing to guess.')

          old_load = """                } else {
                              System.loadLibrary(normalizedName)
                          }"""
          new_load = """                } else if (normalizedName == "PlayFabMultiplayer" ||
                              normalizedName == "maesdk") {
                              try {
                                  System.loadLibrary(normalizedName)
                              } catch (bundledError: UnsatisfiedLinkError) {
                                  // Use only the unmodified library delivered with the installed official
                                  // Minecraft package if this ABI-specific launcher build lacks it.
                                  loadInstalledGameLibrary(fileName, bundledError)
                              }
                          } else {
                              System.loadLibrary(normalizedName)
                          }"""
          if old_load in s:
              if s.count(old_load) != 1:
                  raise SystemExit(f'Expected one library-load branch, found {s.count(old_load)}.')
              s = s.replace(old_load, new_load, 1)
          elif new_load in s:
              print('Installed-package native-library fallback already patched.')
          else:
              raise SystemExit('Expected system library load branch not found; refusing to guess.')

          helper_marker = '    fun loadAllLibraries(\n'
          helper = """    /**
               * Resolve an original, unmodified native library from the installed Minecraft package.
               */
              private fun loadInstalledGameLibrary(
                  fileName: String,
                  initialError: UnsatisfiedLinkError
              ) {
                  var lastError = initialError
                  val installedNative = File(packageContext.applicationInfo.nativeLibraryDir, fileName)
                  if (installedNative.isFile && installedNative.length() > 0L) {
                      try {
                          System.load(installedNative.absolutePath)
                          report("Loaded $fileName from installed Minecraft native library directory")
                          return
                      } catch (error: UnsatisfiedLinkError) {
                          lastError = error
                          Log.w(TAG, "Direct installed-package load failed for $fileName: ${error.message}")
                      }
                  }
          
                  // On devices where native libs remain inside split APKs, copy the exact ABI-matched
                  // archive entry unchanged into the launcher's private cache and load it normally.
                  val abi = getDeviceAbi()
                  for (apk in collectApkFiles()) {
                      var extracted: File? = null
                      try {
                          ZipFile(apk.absolutePath).use { zip ->
                              val entry = zip.getEntry("lib/$abi/$fileName")
                              if (entry != null) {
                                  val destination = File(nativeLibDir, fileName)
                                  zip.getInputStream(entry).use { input ->
                                      copyStreamToReadOnlyFile(input, destination)
                                  }
                                  extracted = destination
                              }
                          }
                      } catch (error: Exception) {
                          Log.w(TAG, "Could not resolve $fileName from ${apk.name}: ${error.message}")
                      }
          
                      val candidate = extracted ?: continue
                      try {
                          System.load(candidate.absolutePath)
                          report("Loaded unmodified $fileName from installed Minecraft package archive ${apk.name}")
                          return
                      } catch (error: UnsatisfiedLinkError) {
                          lastError = error
                          Log.w(TAG, "Archive-extracted load failed for $fileName: ${error.message}")
                      }
                  }
                  throw lastError
              }
          
          """
          if helper_marker in s:
              if 'private fun loadInstalledGameLibrary(' not in s:
                  s = s.replace(helper_marker, helper + helper_marker, 1)
              else:
                  print('Installed-library resolver helper already exists.')
          elif 'private fun loadInstalledGameLibrary(' not in s:
              raise SystemExit('Could not find loadAllLibraries insertion point.')

          path.write_text(s, encoding='utf-8')
          print('Patched native dependency load order and official-game library fallback.')
          PY

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: gradle
          cache-dependency-path: source/**/*.gradle*

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: platform-tools

      - name: Install Android SDK, matching NDK 28.2, and CMake
        shell: bash
        run: |
          set -euo pipefail
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager \
            'platforms;android-36' \
            'build-tools;36.0.0' \
            'ndk;28.2.13676358' \
            'cmake;3.22.1'

      - name: Build debug APK for ARMv7 and capture all output
        id: build
        working-directory: source
        shell: bash
        env:
          GRADLE_OPTS: -Dorg.gradle.daemon=false
        run: |
          set -uo pipefail
          LOG="$RUNNER_TEMP/gradle-native-build.log"
          echo "Full build log: $LOG"
          ./gradlew --no-daemon --stacktrace --info --console=plain :app:assembleDebug 2>&1 | tee "$LOG"
          rc=${PIPESTATUS[0]}
          exit "$rc"

      - name: Summarize native errors if the build failed
        if: failure() || steps.build.outcome == 'failure'
        shell: bash
        run: |
          LOG="$RUNNER_TEMP/gradle-native-build.log"
          {
            echo '## Native build diagnostics'
            echo
            if [ -s "$LOG" ]; then
              echo 'First matching compiler/linker/Ninja diagnostics (the full log is attached as an artifact):'
              echo '```text'
              grep -n -E 'fatal error:|(^|[[:space:]])error:|undefined reference|cannot find|No such file or directory|FAILED:|ninja: build stopped|CMake Error' "$LOG" | head -n 100 || true
              echo '```'
            else
              echo 'No build log was created; check the preceding setup step.'
            fi
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload full build log for diagnosis
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: LeviLauncher-ARMv7-build-log
          path: ${{ runner.temp }}/gradle-native-build.log
          if-no-files-found: warn
          retention-days: 7

      - name: Verify the APK targets ARMv7
        if: success()
        shell: bash
        run: |
          set -euo pipefail
          APK='source/app/build/outputs/apk/debug/app-debug.apk'
          test -s "$APK"
          "$ANDROID_HOME/build-tools/36.0.0/aapt" dump badging "$APK" | tee /tmp/apk-badging.txt
          grep -q "native-code: 'armeabi-v7a'" /tmp/apk-badging.txt
          cp "$APK" 'LeviLauncher-ARMv7-INSTALLED-DEPS-debug.apk'
          python3 - 'LeviLauncher-ARMv7-INSTALLED-DEPS-debug.apk' <<'PY'
          import sys, zipfile
          apk = sys.argv[1]
          required = {
              'lib/armeabi-v7a/libgxcore.so',
              'lib/armeabi-v7a/libc++_shared.so',
          }
          with zipfile.ZipFile(apk) as z:
              names = set(z.namelist())
              missing = sorted(required - names)
              if missing:
                  raise SystemExit('Missing required ARMv7 entries: ' + ', '.join(missing))
              so = z.read('lib/armeabi-v7a/libgxcore.so')
              if so[:4] != b'\x7fELF' or so[4] != 1 or int.from_bytes(so[18:20], 'little') != 40:
                  raise SystemExit('libgxcore.so is not a 32-bit ARM ELF')
              for symbol in (
                  b'Java_org_levimc_launcher_util_NativeBridgeHelper_nativeScanImage',
                  b'Java_org_levimc_launcher_util_NativeBridgeHelper_nativeBootstrapGxCore',
              ):
                  if symbol not in so:
                      raise SystemExit('Missing shim JNI symbol: ' + symbol.decode())
          print('Verified ARMv7 compatibility shim and libc++ runtime in', apk)
          PY
          sha256sum 'LeviLauncher-ARMv7-INSTALLED-DEPS-debug.apk'

      - name: Upload installable APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: LeviLauncher-ARMv7-INSTALLED-DEPS-debug-APK
          path: LeviLauncher-ARMv7-INSTALLED-DEPS-debug.apk
          if-no-files-found: error
          retention-days: 7

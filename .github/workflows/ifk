name: Build LeviLaunchroid Upstream for ARMv7

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-upstream-armv7:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Upstream LeviLaunchroid (v1.5.27 pinned commit)
        uses: actions/checkout@v4
        with:
          repository: 'LiteLDev/LeviLaunchroid'
          ref: 'a8531393d3a336812748a9bb45582a3d9791af7b'
          submodules: recursive

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Android SDK & NDK r25b (API 29)
        uses: android-actions/setup-android@v3
        with:
          packages: 'platforms;android-29 build-tools;34.0.0 ndk;25.2.9519653 cmake;3.22.1'

      - name: Patch Gradle ABI Filters and Properties for armeabi-v7a
        run: |
          # Replace arm64-v8a with armeabi-v7a across all gradle and cmake configuration files
          find . -name "build.gradle*" -o -name "*.kts" -o -name "CMakeLists.txt" | while read file; do
            if grep -q "arm64-v8a" "$file"; then
              echo "Patching ABI filters in $file"
              sed -i 's/arm64-v8a/armeabi-v7a/g' "$file"
            fi
          done

      - name: Build Debug APK (armeabi-v7a)
        run: |
          chmod +x gradlew || true
          ./gradlew assembleDebug --no-daemon

      - name: Verify APK ABI Contents (Strict 32-bit Check)
        run: |
          unzip -l app/build/outputs/apk/debug/*.apk | grep "lib/"
          if unzip -l app/build/outputs/apk/debug/*.apk | grep -q "lib/arm64-v8a/"; then
            echo "ERROR: arm64-v8a libraries detected!"
            exit 1
          fi

      - name: Upload ARMv7 APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: levilauncher-armv7-debug-apk
          path: app/build/outputs/apk/debug/*.apk
